# المنفذ الخاص بالواجهة الأمامية (Vite)
PORT=5173

# المنفذ الخاص بخادم الـ API
API_PORT=5000

# المسار الأساسي للموقع
BASE_PATH=/

# مسار الاتصال بقاعدة بيانات PostgreSQL
DATABASE_URL=postgresql://postgres:password@localhost:5432/dayar_db

# مفتاح التشفير للجلسات (يمكنك وضع أي نص عشوائي قوي هنا)
SESSION_SECRET=super_secret_key_for_dayar_al_ahlam_development

# بيانات دخول لوحة التحكم الإدارية
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_secure_password

